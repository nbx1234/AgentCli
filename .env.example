# AgentCli 环境变量样例
# 复制为 .env 后填入你自己的 key，.env 已在 .gitignore 中

# === LLM Provider（Day 1+ 起用，至少填一个）===
# DeepSeek（推荐，国内 SSE 稳）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 智谱 GLM
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Step
STEP_API_KEY=
STEP_BASE_URL=https://api.stepfun.com/v1

# Kimi
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1

# === Web UI（差异点 2，Day 7+ 起用）===
AGENTCLI_WEB_PORT=8080
AGENTCLI_WEB_HOST=127.0.0.1

# === 录制回放（差异点 3，Day 13+ 起用）===
AGENTCLI_TRACE_DIR=~/.agentcli/traces
